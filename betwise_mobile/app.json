{
  "expo": {
    "name": "BetWise",
    "slug": "betwise-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/master_1024.png",
    "scheme": "betwise",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E1416",
    "splash": {
      "backgroundColor": "#0E1416",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.betwise.mobile"
    },
    "android": {
      "package": "com.betwise.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/glyph_transparent_1024.png",
        "backgroundColor": "#0E1416"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "extra": {
      "apiBaseUrl": "http://localhost:8000/api"
    }
  }
}
